{
  "manifest_version": 3,
  "name": "小雅刷课助手",
  "version": "0.2.1",
  "minimum_chrome_version": "120",
  "description": "小雅课件队列、视频倍速、后台播放与完成状态确认。",
  "permissions": ["storage", "alarms", "scripting"],
  "host_permissions": ["https://whut.ai-augmented.com/*"],
  "background": { "service_worker": "worker.js" },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_popup": "popup.html", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "content_scripts": [
    { "matches": ["https://whut.ai-augmented.com/app/jx-web/*"], "js": ["background-mode.js"], "run_at": "document_start", "world": "MAIN" },
    { "matches": ["https://whut.ai-augmented.com/app/jx-web/*"], "js": ["task-timing.js", "content.js"], "run_at": "document_idle" }
  ]
}
